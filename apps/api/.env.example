# Copy to .env. Matches docker-compose.yml (note port 5435, not 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/devpulse?schema=public"
# Allowed CORS origin (the web app).
WEB_ORIGIN="http://localhost:3000"
# pino level: trace | debug | info | warn | error
LOG_LEVEL="info"
# GitHub personal access token used by POST /teams/:teamId/sync. Never logged.
GITHUB_TOKEN=""
# Anthropic API key used for CLAUDE API calls
ANTHROPIC_API_KEY=""
# Base URL the Ask DevPulse tools call back into (loopback). Defaults to http://localhost:$PORT (4000).
API_SELF_URL="http://localhost:4000"
