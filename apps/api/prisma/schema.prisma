generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueState {
  OPEN
  CLOSED
}

// `state` is the source of truth; `mergedAt` is set only when state = MERGED.
enum PrState {
  OPEN
  CLOSED
  MERGED
}

model Team {
  id           String       @id @default(uuid())
  name         String
  createdAt    DateTime     @default(now())
  members      Member[]
  repositories Repository[]
}

model Member {
  id          String @id @default(uuid())
  name        String
  githubLogin String @unique @db.Citext
  teamId      String
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([teamId])
}

model Repository {
  id             String        @id @default(uuid())
  githubFullName String        @unique @db.Citext
  githubId       BigInt?       @unique
  teamId        String
  team           Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  issues         Issue[]
  pullRequests   PullRequest[]

  @@index([teamId])
}

model Issue {
  id              String     @id @default(uuid())
  repositoryId    String
  repository      Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  state           IssueState
  labels          String[]
  priority        Priority   @default(MEDIUM)
  aiSummary       String?
  githubCreatedAt DateTime

  @@unique([repositoryId, number])
}

model PullRequest {
  id                String     @id @default(uuid())
  repositoryId      String
  repository        Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  number            Int
  title             String
  state             PrState
  author            String
  reviewRequestedAt DateTime?
  mergedAt          DateTime?

  @@unique([repositoryId, number])
}
